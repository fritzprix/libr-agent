# LibrAgent environment template (copy to .env / .env.dev / .env.demo)
# Secrets stay in local gitignored files — never commit real keys.

# ---------------------------------------------------------------------------
# Profiles: prod | dev | demo
# CLI: --demo  OR  --profile demo
# ---------------------------------------------------------------------------
# LIBRAGENT_PROFILE=demo
# LIBRAGENT_DATA_DIR=/custom/data/dir
# LIBRAGENT_DB_PATH=/custom/path/libragent_v2.demo.db

# Demo clean slate (default on for demo). Keep state with:
# LIBRAGENT_DEMO_PERSIST=1
# Force wipe:
# LIBRAGENT_DEMO_RESET=1

# ---------------------------------------------------------------------------
# App Control MCP (hero chrome / remote UI)
# ---------------------------------------------------------------------------
# LIBRAGENT_MCP_ENABLE=1
# LIBRAGENT_APP_CONTROL=1

# ---------------------------------------------------------------------------
# LLM seed (written into settings on boot when set)
# OpenAI-compatible custom endpoint → provider=openai + BASE_URL
# ---------------------------------------------------------------------------
# LIBRAGENT_LLM_PROVIDER=openai
# LIBRAGENT_LLM_MODEL=Qwen3.6-35B-A3B-NoThinking
# LIBRAGENT_LLM_BASE_URL=http://192.168.0.75:4444/v1
# LIBRAGENT_LLM_API_KEY=your-api-key
# OPENAI_API_KEY=your-api-key
