{
  "manifest_version": 3,
  "name": "LibrAgent Browser Bridge",
  "version": "0.2.0",
  "description": "Local WebSocket bridge so LibrAgent can drive everyday Chrome tabs (Load unpacked MVP).",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "LibrAgent Browser Bridge"
  }
}
