{
  "name": "libragent",
  "private": true,
  "version": "0.4.2",
  "description": "A desktop app for AI agents with built-in tools",
  "author": "fritzprix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fritzprix/libr-agent.git"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "mcp",
    "model-context-protocol",
    "react",
    "desktop",
    "shareable-config"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "tauri": "tauri",
    "diagnose": "echo 'System diagnostic...' && ldd --version && echo 'WebKit packages:' && dpkg -l | grep webkit",
    "dead-code": "unimported",
    "dead-code:init": "unimported --init",
    "rust:fmt": "cd src-tauri && cargo fmt --check",
    "rust:fmt:fix": "cd src-tauri && cargo fmt",
    "rust:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:check": "cd src-tauri && cargo check",
    "rust:check:all": "cd src-tauri && cargo check --all-features",
    "rust:test": "cd src-tauri && cargo test",
    "rust:validate": "pnpm rust:fmt && pnpm rust:clippy && pnpm rust:check:all",
    "refactor:validate": "pnpm lint && pnpm format && pnpm test:run && pnpm rust:validate && pnpm rust:test && pnpm build && pnpm dead-code",
    "verify-planning": "node scripts/extract-planning-logs.js",
    "verify-planning:file": "node scripts/extract-planning-logs.js",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.64.0",
    "@cerebras/cerebras_cloud_sdk": "^1.35.0",
    "@dqbd/tiktoken": "^1.0.22",
    "@google/genai": "^1.10.0",
    "@mcp-ui/client": "^5.6.2",
    "@mcp-ui/server": "^5.2.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@remote-dom/core": "^1.9.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-log": "~2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-deep-equal": "^3.1.3",
    "groq-sdk": "^0.27.0",
    "handlebars": "^4.7.8",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "immer": "^10.1.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.526.0",
    "next-themes": "^0.4.6",
    "ollama": "^0.6.3",
    "openai": "^5.9.0",
    "postcss": "^8.5.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.7.1",
    "react-use": "^17.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.6",
    "swr": "^2.3.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "turndown": "^7.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.0.0",
    "html-validate": "^10.6.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "unimported": "^1.31.1",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.17"
  }
}
