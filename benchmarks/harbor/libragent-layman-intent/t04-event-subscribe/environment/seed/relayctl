#!/usr/bin/env python3
"""Mock event relay CLI (benchmark fixture). Records subscriptions; never fires them."""
import argparse
import json
import sys
import time
from pathlib import Path

STORE = Path("/app/.relay/subscriptions.json")
TOPICS = {
    "build.finished": "a CI build finished (any result)",
    "deploy.finished": "a deployment finished (any result)",
    "release.gate.passed": "the release gate checks all passed",
    "release.gate.failed": "the release gate checks failed",
}


def load():
    return json.loads(STORE.read_text()) if STORE.exists() else []


def fail(message):
    print(f"relayctl: error: {message}", file=sys.stderr)
    sys.exit(2)


def cmd_topics(_):
    for name, desc in TOPICS.items():
        print(f"{name:22} {desc}")


def cmd_subscribe(args):
    if args.topic not in TOPICS:
        fail(f"unknown topic '{args.topic}'. Run 'relayctl topics' to list valid topics.")
    if not args.exec:
        fail("--exec COMMAND is required: the shell command to run when the topic fires.")
    subs = load()
    sub = {
        "id": f"sub-{len(subs) + 1}",
        "topic": args.topic,
        "exec": args.exec,
        "once": args.once,
        "registered_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    STORE.parent.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(subs + [sub], indent=2))
    print(f"subscribed {sub['id']} topic={args.topic} once={str(args.once).lower()}")


def cmd_list(_):
    for sub in load():
        print(f"{sub['id']} {sub['topic']} once={str(sub['once']).lower()} exec={sub['exec']}")


def main():
    parser = argparse.ArgumentParser(
        prog="relayctl",
        description="Subscribe a shell command to relay events. The relay daemon runs "
        "the command when the topic fires, after you have gone idle; nothing needs to stay running.",
    )
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("topics", help="list event topics").set_defaults(fn=cmd_topics)
    s = sub.add_parser("subscribe", help="run a command when a topic fires")
    s.add_argument("--topic", required=True, help="topic name (see 'relayctl topics')")
    s.add_argument("--exec", help="shell command to run when the topic fires")
    s.add_argument("--once", action="store_true", help="unsubscribe after the first firing")
    s.set_defaults(fn=cmd_subscribe)
    sub.add_parser("list", help="list active subscriptions").set_defaults(fn=cmd_list)
    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
