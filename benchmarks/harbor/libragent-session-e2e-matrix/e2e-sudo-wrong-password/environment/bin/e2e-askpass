#!/usr/bin/env bash
# TEST-ONLY fake askpass shim (#2904).
# Records every invocation (never the password value!) to
# $LIBRAGENT_E2E_PRIVILEGED_LOG_DIR/askpass.log and returns according to
# LIBRAGENT_E2E_FAKE_ASKPASS_MODE (succeed | fail; default succeed).
set -euo pipefail

LOG_DIR="${LIBRAGENT_E2E_PRIVILEGED_LOG_DIR:-/app/.e2e-privileged-logs}"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/askpass.log"

python3 - "$LOG_FILE" "$@" <<'PY'
import json, os, sys, time
log_file = sys.argv[1]
argv = sys.argv[2:]
record = {
    "tool": "askpass",
    "timestamp": time.time(),
    "uid": os.getuid(),
    "mode": os.environ.get("LIBRAGENT_E2E_FAKE_ASKPASS_MODE", "succeed"),
    "prompt": " ".join(argv),
}
with open(log_file, "a", encoding="utf-8") as fh:
    fh.write(json.dumps(record) + "\n")
PY

MODE="${LIBRAGENT_E2E_FAKE_ASKPASS_MODE:-succeed}"
if [ "$MODE" = "fail" ]; then
  echo "e2e-fake-askpass: configured to fail" >&2
  exit 1
fi

printf '%s\n' "${LIBRAGENT_E2E_FAKE_ASKPASS_VALUE:-e2e-sudo-fixture}"
