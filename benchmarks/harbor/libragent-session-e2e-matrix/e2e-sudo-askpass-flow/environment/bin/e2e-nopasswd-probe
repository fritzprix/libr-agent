#!/usr/bin/env bash
# TEST-ONLY NOPASSWD sudo probe (#2904).
#
# Every invocation appends a record to
# $LIBRAGENT_E2E_PRIVILEGED_LOG_DIR/probe.log. Tasks whose verifier asserts
# pkexec.log/askpass.log are EMPTY use this as the positive control (PR #2917
# G2.2): the agent's shell reaches the log dir through sudo, so the verifier
# can prove the shared dir is actually visible before trusting an empty
# "never invoked" log.
set -euo pipefail

LOG_DIR="${LIBRAGENT_E2E_PRIVILEGED_LOG_DIR:-/app/.e2e-privileged-logs}"
mkdir -p "$LOG_DIR"

python3 - "$LOG_DIR/probe.log" <<'PY'
import json, os, sys, time
record = {
    "tool": "e2e-nopasswd-probe",
    "timestamp": time.time(),
    "uid": os.getuid(),
}
with open(sys.argv[1], "a", encoding="utf-8") as fh:
    fh.write(json.dumps(record) + "\n")
PY

echo "NOPASSWD_PROBE_UID=$(id -u)"
