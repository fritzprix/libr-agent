<!doctype html>
<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <style>
      * {
        box-sizing: border-box;
      }
      /*
        Prefer LibrAgent host-injected tokens (--background, --card, …).
        Hex fallbacks keep the widget usable when opened outside the app.
      */
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 16px;
        background: var(--background, #f9fafb);
        color: var(--foreground, #1f2937);
        font-size: 15px;
        line-height: 1.6;
      }
      .container {
        max-width: 720px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .content-wrapper {
        position: relative;
        background: var(--card, #ffffff);
        color: var(--card-foreground, #111827);
        border-radius: 8px;
        padding: 24px 28px;
        box-shadow: 0 1px 3px color-mix(in oklab, var(--foreground, #000000) 12%, transparent);
        border: 1px solid var(--border, #e5e7eb);
      }
      .action-buttons {
        position: absolute;
        top: 16px;
        right: 16px;
        display: flex;
        gap: 8px;
        z-index: 10;
      }
      .icon-btn {
        background: var(--muted, #f9fafb);
        color: var(--muted-foreground, #4b5563);
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 6px;
        padding: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .icon-btn:hover {
        background: var(--accent, #e5e7eb);
        color: var(--accent-foreground, #111827);
      }
      .icon-btn svg {
        width: 16px;
        height: 16px;
      }
      .export-menu {
        position: relative;
      }
      .export-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        min-width: 10.5rem;
        background: var(--card, #ffffff);
        color: var(--card-foreground, #111827);
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 8px;
        box-shadow: 0 8px 20px color-mix(in oklab, var(--foreground, #000) 16%, transparent);
        padding: 4px;
        z-index: 20;
      }
      .export-dropdown[hidden] {
        display: none;
      }
      .export-dropdown button {
        display: flex;
        width: 100%;
        align-items: center;
        gap: 8px;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 13px;
        text-align: left;
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
      }
      .export-dropdown button:hover {
        background: var(--muted, #f3f4f6);
      }
      .content-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--card-foreground, #111827);
        margin: 0 0 16px 0;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border, #e5e7eb);
        padding-right: 80px;
      }
      
      /* Interaction Section */
      .interaction-wrapper {
        background: var(--card, #ffffff);
        color: var(--card-foreground, #111827);
        border-radius: 8px;
        padding: 20px 28px;
        box-shadow: 0 1px 3px color-mix(in oklab, var(--foreground, #000000) 12%, transparent);
        border: 1px solid var(--border, #e5e7eb);
        border-top: 4px solid #3b82f6;
      }
      .interaction-prompt {
        font-weight: 600;
        margin-bottom: 16px;
        color: var(--card-foreground, #1f2937);
        font-size: 16px;
      }
      .options-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
      }
      .option-item {
        display: flex;
        align-items: center;
        padding: 12px;
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .option-item:hover {
        background: var(--muted, #f9fafb);
        border-color: #3b82f6;
      }
      .option-input {
        margin-right: 12px;
        cursor: pointer;
      }
      .option-label {
        flex: 1;
        font-size: 14px;
        color: var(--foreground, #374151);
      }
      .text-input {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--input, #d1d5db);
        border-radius: 6px;
        font-family: inherit;
        font-size: 14px;
        margin-bottom: 20px;
        outline: none;
        background: var(--background, #ffffff);
        color: var(--foreground, #1f2937);
      }
      .text-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
      }
      .interaction-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
      }
      .btn {
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-primary {
        background: #3b82f6;
        color: #ffffff;
      }
      .btn-primary:hover {
        background: #2563eb;
      }
      .btn-secondary {
        background: var(--secondary, #e5e7eb);
        color: var(--secondary-foreground, #374151);
      }
      .btn-secondary:hover {
        background: var(--muted, #d1d5db);
      }

      /* Markdown rendered styles */
      .md h1 { font-size: 1.6em; font-weight: 700; margin: 0 0 12px; color: var(--card-foreground, #111827); }
      .md h2 { font-size: 1.3em; font-weight: 600; margin: 20px 0 8px; color: var(--foreground, #1f2937); }
      .md h3 { font-size: 1.1em; font-weight: 600; margin: 16px 0 6px; color: var(--muted-foreground, #374151); }
      .md p  { margin: 0 0 12px; }
      .md ul, .md ol { margin: 0 0 12px; padding-left: 24px; }
      .md li { margin-bottom: 4px; }
      .md code {
        background: var(--muted, #f3f4f6);
        border-radius: 3px;
        padding: 2px 5px;
        font-family: ui-monospace, monospace;
        font-size: 0.88em;
        color: #4f46e5;
      }
      .md pre {
        background: #1e293b;
        color: #e2e8f0;
        border-radius: 6px;
        padding: 14px 16px;
        overflow-x: auto;
        margin: 0 0 14px;
      }
      .md table { border-collapse: collapse; width: 100%; margin: 0 0 14px; font-size: 0.93em; }
      .md th { background: var(--muted, #f3f4f6); font-weight: 600; }
      .md th, .md td { border: 1px solid var(--border, #d1d5db); padding: 7px 12px; text-align: left; }
      .md .math-inline {
        font-family: 'Cambria Math', 'STIX Two Math', 'Times New Roman', serif;
        font-style: italic;
        padding: 0 1px;
      }
      .md .math-display {
        font-family: 'Cambria Math', 'STIX Two Math', 'Times New Roman', serif;
        font-style: italic;
        text-align: center;
        margin: 12px 0;
        padding: 8px 12px;
        background: var(--muted, #f3f4f6);
        border-radius: 6px;
        overflow-x: auto;
      }
      .md .katex { font-size: 1.05em; color: inherit; font-style: normal; }
      .md .katex-display { margin: 0.4em 0; }
      .md .mermaid-diagram {
        overflow-x: auto;
        margin: 12px 0;
        padding: 16px;
        background: var(--muted, #f3f4f6);
        border-radius: 8px;
        border: 1px solid var(--border, #e5e7eb);
        min-height: 4rem;
      }
      .md .mermaid-diagram svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }
      .md .mermaid-pending {
        color: var(--muted-foreground, #6b7280);
        font-size: 13px;
      }
      .md .mermaid-error {
        color: #b91c1c;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .md .mermaid-error-source {
        margin: 0;
        padding: 8px;
        font-size: 12px;
        overflow-x: auto;
        background: color-mix(in oklab, var(--foreground, #000) 6%, transparent);
        border-radius: 6px;
        white-space: pre;
      }
    </style>
    {{#if isMarkdown}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.css" crossorigin="anonymous" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.min.js" crossorigin="anonymous"></script>
    {{/if}}
  </head>
  <body>
    <div class="container">
      <div class='content-wrapper'>
        <div class="action-buttons">
          <button type="button" id="copy-btn" class="icon-btn" title="Copy to clipboard">
            <svg id="icon-copy" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <svg id="icon-check" style="display: none; color: #10b981;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
          <div class="export-menu">
            <button type="button" id="export-btn" class="icon-btn" title="Export" aria-haspopup="menu" aria-expanded="false">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            </button>
            <div id="export-menu" class="export-dropdown" role="menu" hidden>
              {{#if isMarkdown}}
              <button type="button" data-export="markdown" role="menuitem">Export as Markdown</button>
              <button type="button" data-export="pdf" role="menuitem">Export as PDF</button>
              {{else}}
              <button type="button" data-export="html" role="menuitem">Export as HTML</button>
              {{/if}}
            </div>
          </div>
        </div>
        {{#if title}}
          <div class='content-title' id="content-title">{{title}}</div>
        {{else}}
          <div id="content-title" hidden></div>
        {{/if}}
        
        <script id='raw-data' type='application/json'>{{{contentJson}}}</script>

        {{#if isMarkdown}}
          <div class='md' id='md-root'></div>
          <script>
            (function () {
              var raw = '';
              try {
                var dataEl = document.getElementById('raw-data');
                raw = dataEl ? JSON.parse(dataEl.textContent || '""') : '';
              } catch (e) { raw = ''; }

              function escape(s) {
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
              }

              function escapeAttr(s) {
                return escape(s).replace(/"/g, '&quot;');
              }

              function mathHtml(tex, display) {
                var safe = escape(tex);
                var attr = escapeAttr(tex);
                if (display) {
                  return '<div class="math-display" data-tex="' + attr + '">' + safe + '</div>';
                }
                return '<span class="math-inline" data-tex="' + attr + '">' + safe + '</span>';
              }

              function escapeExceptPlaceholders(s) {
                return s.split(/(@@PH_\d+@@)/).map(function (part) {
                  return /^@@PH_\d+@@$/.test(part) ? part : escape(part);
                }).join('');
              }

              function parseInline(s) {
                var placeholders = [];

                // 1. Protect inline code (before escape / markdown)
                s = s.replace(/`([^`]+)`/g, function (_, code) {
                  var idx = placeholders.length;
                  placeholders.push('<code>' + escape(code) + '</code>');
                  return '@@PH_' + idx + '@@';
                });

                // 2. Protect remaining single-line display math $$...$$
                s = s.replace(/\$\$([^\$]+?)\$\$/g, function (_, math) {
                  var idx = placeholders.length;
                  placeholders.push(mathHtml(math.trim(), true));
                  return '@@PH_' + idx + '@@';
                });

                // 3. Protect inline math $...$ (require non-space edges to avoid $5)
                s = s.replace(/\$([^\$\s](?:[^\$\n]*[^\$\s])?)\$/g, function (_, math) {
                  var idx = placeholders.length;
                  placeholders.push(mathHtml(math, false));
                  return '@@PH_' + idx + '@@';
                });

                // 4. Escape HTML in remaining text (math/code already protected)
                s = escapeExceptPlaceholders(s);

                // 5. Links (URL checked; link text already escaped)
                s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(_, text, url) {
                  var safe = /^(https?:|mailto:|#)/.test(url.trim()) ? url : '#';
                  return '<a href="' + safe + '" target="_blank" rel="noopener">' + text + '</a>';
                });

                // 6. Bold & Italic
                s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                     .replace(/__([^_]+)__/g, '<strong>$1</strong>');

                s = s.replace(/(^|[^\s*])\*([^\s*](?:[^*]*[^\s*])?)\*([^\s*]|$)/g, '$1<em>$2</em>$3');
                s = s.replace(/(^|[\s(])_([^\s_](?:[^_]*[^\s_])?)_([\s).,!?:;]|$)/g, '$1<em>$2</em>$3');

                s = s.replace(/@@PH_(\d+)@@/g, function (_, idx) {
                  return placeholders[parseInt(idx, 10)] || '';
                });

                return s;
              }

              function parseMarkdown(md) {
                // Protect fenced / inline code before math extraction so $$ inside
                // code is not treated as LaTeX.
                var protectedBlocks = [];
                md = md.replace(/```[\s\S]*?```/g, function (block) {
                  var idx = protectedBlocks.length;
                  protectedBlocks.push({ type: 'fence', text: block });
                  return '\n@@PROTECT_' + idx + '@@\n';
                });
                md = md.replace(/`([^`]+)`/g, function (block) {
                  var idx = protectedBlocks.length;
                  protectedBlocks.push({ type: 'inline', text: block });
                  return '@@PROTECT_' + idx + '@@';
                });

                // Extract display math BEFORE line split + HTML escape so &= / <
                // remain valid LaTeX for KaTeX (including multiline blocks).
                var mathBlocks = [];
                md = md.replace(/\$\$([\s\S]+?)\$\$/g, function (_, math) {
                  var idx = mathBlocks.length;
                  mathBlocks.push(mathHtml(math.trim(), true));
                  return '\n@@MATHBLOCK_' + idx + '@@\n';
                });

                // Restore protected code as opaque line tokens for the line parser
                md = md.replace(/@@PROTECT_(\d+)@@/g, function (_, idx) {
                  var block = protectedBlocks[parseInt(idx, 10)];
                  if (!block) return '';
                  if (block.type === 'inline') {
                    return block.text;
                  }
                  return '\n@@FENCE_' + idx + '@@\n';
                });

                var lines = md.split('\n');
                var html = '';
                var i = 0;

                while (i < lines.length) {
                  var line = lines[i];

                  var fenceMatch = line.trim().match(/^@@FENCE_(\d+)@@$/);
                  if (fenceMatch) {
                    var fence = protectedBlocks[parseInt(fenceMatch[1], 10)];
                    if (fence && fence.type === 'fence') {
                      var fenceBody = fence.text.replace(/^```[^\n]*\n?/, '').replace(/\n?```$/, '');
                      var fenceInfo = (fence.text.match(/^```([^\n]*)/) || [])[1] || '';
                      fenceInfo = fenceInfo.trim();
                      var fenceLang = (fenceInfo.split(/\s+/)[0] || '').toLowerCase();
                      if (fenceLang === 'mermaid') {
                        // Chat MermaidBlock parity: diagram container + source for lazy render.
                        html += '<div class="mermaid-diagram" data-mermaid="true">' +
                          '<pre class="mermaid-source" hidden>' + escape(fenceBody) + '</pre>' +
                          '<div class="mermaid-pending">Rendering diagram…</div>' +
                          '</div>\n';
                      } else {
                        html += '<pre><code' + (fenceInfo ? ' class="language-' + escape(fenceInfo) + '"' : '') + '>' +
                                 escape(fenceBody) + '</code></pre>\n';
                      }
                    }
                    i++; continue;
                  }

                  var mathBlockMatch = line.trim().match(/^@@MATHBLOCK_(\d+)@@$/);
                  if (mathBlockMatch) {
                    html += '</p>' + (mathBlocks[parseInt(mathBlockMatch[1], 10)] || '') + '<p>';
                    i++; continue;
                  }

                  var hm = line.match(/^(#{1,6})\s+(.+)$/);
                  if (hm) {
                    var lvl = hm[1].length;
                    html += '<h' + lvl + '>' + parseInline(hm[2]) + '</h' + lvl + '>\n';
                    i++; continue;
                  }

                  if (/^---+$/.test(line.trim())) {
                    html += '<hr />\n'; i++; continue;
                  }

                  if (/^>\s?/.test(line)) {
                    var bqLines = [];
                    while (i < lines.length && /^>\s?/.test(lines[i])) {
                      bqLines.push(lines[i].replace(/^>\s?/, ''));
                      i++;
                    }
                    html += '<blockquote>' + parseInline(bqLines.join(' ')) + '</blockquote>\n';
                    continue;
                  }

                  if (/\|/.test(line) && i + 1 < lines.length && /^[\|\s\-:]+$/.test(lines[i + 1])) {
                    var headers = line.split('|').filter(function(c){ return c.trim(); });
                    i += 2;
                    html += '<table><thead><tr>' +
                      headers.map(function(h){ return '<th>' + parseInline(h.trim()) + '</th>'; }).join('') +
                      '</tr></thead><tbody>';
                    while (i < lines.length && /\|/.test(lines[i])) {
                      var cells = lines[i].split('|').filter(function(c){ return c.trim(); });
                      html += '<tr>' + cells.map(function(c){ return '<td>' + parseInline(c.trim()) + '</td>'; }).join('') + '</tr>\n';
                      i++;
                    }
                    html += '</tbody></table>\n';
                    continue;
                  }

                  if (/^[\-\*\+]\s/.test(line)) {
                    html += '<ul>\n';
                    while (i < lines.length && /^[\-\*\+]\s/.test(lines[i])) {
                      html += '<li>' + parseInline(lines[i].replace(/^[\-\*\+]\s/, '')) + '</li>\n';
                      i++;
                    }
                    html += '</ul>\n';
                    continue;
                  }

                  if (/^\d+\.\s/.test(line)) {
                    // Preserve markdown numbering when lists split around math/prose
                    var startNum = (line.match(/^(\d+)\./) || [])[1] || '1';
                    html += '<ol start="' + startNum + '">\n';
                    while (i < lines.length && /^\d+\.\s/.test(lines[i])) {
                      html += '<li>' + parseInline(lines[i].replace(/^\d+\.\s/, '')) + '</li>\n';
                      i++;
                    }
                    html += '</ol>\n';
                    continue;
                  }

                  if (line.trim() === '') { html += '</p><p>'; i++; continue; }
                  html += parseInline(line) + ' ';
                  i++;
                }

                return ('<p>' + html.replace(/<\/p><p>\s*<\/p><p>/g, '</p><p>') + '</p>')
                  .replace(/<p>\s*<\/p>/g, '');
              }

              function renderMath(root) {
                if (typeof katex === 'undefined' || !root) return;

                function renderOne(el, displayMode) {
                  if (el.getAttribute('data-katex-rendered') === 'true') return;
                  var tex = el.getAttribute('data-tex');
                  if (tex == null || !String(tex).trim()) {
                    tex = el.textContent || '';
                  }
                  if (!String(tex).trim()) return;
                  try {
                    katex.render(tex, el, { throwOnError: false, displayMode: displayMode });
                    el.setAttribute('data-katex-rendered', 'true');
                  } catch (err) { /* keep escaped source */ }
                }

                root.querySelectorAll('.math-display').forEach(function (el) {
                  renderOne(el, true);
                });
                root.querySelectorAll('.math-inline').forEach(function (el) {
                  renderOne(el, false);
                });
              }

              function isDarkTheme() {
                try {
                  var scheme = getComputedStyle(document.documentElement).colorScheme;
                  if (scheme === 'dark') return true;
                  if (scheme === 'light') return false;
                } catch (e) { /* ignore */ }
                return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
              }

              var mermaidThemeApplied = null;
              var mermaidQueue = Promise.resolve();

              function renderMermaid(root) {
                if (typeof mermaid === 'undefined' || !root) return;
                var nodes = root.querySelectorAll('.mermaid-diagram[data-mermaid="true"]:not([data-mermaid-rendered])');
                if (!nodes.length) return;

                var theme = isDarkTheme() ? 'dark' : 'default';
                if (mermaidThemeApplied !== theme) {
                  mermaid.initialize({
                    startOnLoad: false,
                    securityLevel: 'strict',
                    theme: theme
                  });
                  mermaidThemeApplied = theme;
                }

                Array.prototype.forEach.call(nodes, function (el) {
                  var sourceEl = el.querySelector('.mermaid-source');
                  var code = sourceEl ? String(sourceEl.textContent || '').trim() : '';
                  if (!code) {
                    el.setAttribute('data-mermaid-rendered', 'true');
                    return;
                  }

                  var run = function () {
                    var id = 'mmd-pi-' + Math.random().toString(36).slice(2, 10);
                    return mermaid.render(id, code).then(function (result) {
                      el.innerHTML = result.svg;
                      el.setAttribute('data-mermaid-rendered', 'true');
                      if (typeof scheduleResizeReport === 'function') {
                        scheduleResizeReport();
                      }
                    }).catch(function () {
                      el.innerHTML =
                        '<div class="mermaid-error">Failed to render Mermaid diagram</div>' +
                        '<pre class="mermaid-error-source">' + escape(code) + '</pre>';
                      el.setAttribute('data-mermaid-rendered', 'error');
                      if (typeof scheduleResizeReport === 'function') {
                        scheduleResizeReport();
                      }
                    }).finally(function () {
                      // mermaid.render mounts temp SVG nodes on document.body
                      var temp = document.getElementById(id);
                      if (temp && temp.parentNode) temp.parentNode.removeChild(temp);
                      var d = document.getElementById('d' + id);
                      if (d && d.parentNode) d.parentNode.removeChild(d);
                      var iEl = document.getElementById('i' + id);
                      if (iEl && iEl.parentNode) iEl.parentNode.removeChild(iEl);
                    });
                  };

                  // Keep queue head alive after rejections (chat loader parity).
                  var next = mermaidQueue.then(run, run);
                  mermaidQueue = next.then(function () {}, function () {});
                });
              }

              var mdRoot = document.getElementById('md-root');
              mdRoot.innerHTML = parseMarkdown(raw);

              function applyKatexWhenReady() {
                renderMath(mdRoot);
                if (typeof scheduleResizeReport === 'function') {
                  scheduleResizeReport();
                }
              }

              function applyMermaidWhenReady() {
                renderMermaid(mdRoot);
              }

              if (typeof katex !== 'undefined') {
                applyKatexWhenReady();
              } else {
                var katexWait = 0;
                var katexPoll = setInterval(function () {
                  katexWait += 1;
                  if (typeof katex !== 'undefined') {
                    clearInterval(katexPoll);
                    applyKatexWhenReady();
                  } else if (katexWait > 100) {
                    clearInterval(katexPoll);
                  }
                }, 50);
              }

              if (typeof mermaid !== 'undefined') {
                applyMermaidWhenReady();
              } else {
                var mermaidWait = 0;
                var mermaidPoll = setInterval(function () {
                  mermaidWait += 1;
                  if (typeof mermaid !== 'undefined') {
                    clearInterval(mermaidPoll);
                    applyMermaidWhenReady();
                  } else if (mermaidWait > 100) {
                    clearInterval(mermaidPoll);
                  }
                }, 50);
              }
            })();
          </script>
        {{else}}
          <div>{{{content}}}</div>
        {{/if}}
      </div>

      {{#if interaction}}
      <div class="interaction-wrapper">
        <div class="interaction-prompt">{{interaction.prompt}}</div>
        <div class="interaction-form">
          {{#if isText}}
            <input type="text" id="text-answer" class="text-input" placeholder="Type your answer here..." autofocus>
          {{else}}
            <div class='options-list'>{{{optionsHtml}}}</div>
          {{/if}}
          
          <div class='interaction-actions'>
            <button id='cancel-btn' class='btn btn-secondary'>Cancel</button>
            <button id='submit-btn' class='btn btn-primary'>Submit</button>
          </div>
        </div>
      </div>
      {{/if}}
    </div>

    <script>
      // Auto-resize logic for MCP-UI client autoResizeIframe.
      // Measure the actual content box instead of scrollHeight so iframe viewport
      // changes do not recursively inflate the reported height.
      const resizeTarget = document.querySelector('.container') || document.body;
      const bodyStyles = window.getComputedStyle(document.body);
      const bodyPaddingY =
        parseFloat(bodyStyles.paddingTop || '0') +
        parseFloat(bodyStyles.paddingBottom || '0');
      let lastReportedHeight = 0;
      let resizeFrame = null;

      function measureContentHeight() {
        const targetRect = resizeTarget.getBoundingClientRect();
        const measuredHeight =
          resizeTarget === document.body
            ? targetRect.height
            : targetRect.height + bodyPaddingY;

        return Math.max(1, Math.ceil(measuredHeight));
      }

      function reportSizeIfChanged() {
        resizeFrame = null;
        const height = measureContentHeight();
        if (height === lastReportedHeight) {
          return;
        }

        lastReportedHeight = height;
        window.parent.postMessage(
          { type: 'ui-size-change', payload: { height } },
          '*',
        );
      }

      function scheduleResizeReport() {
        if (resizeFrame !== null) {
          cancelAnimationFrame(resizeFrame);
        }
        resizeFrame = requestAnimationFrame(reportSizeIfChanged);
      }

      const ro = new ResizeObserver(scheduleResizeReport);
      ro.observe(resizeTarget);
      window.addEventListener('load', scheduleResizeReport);
      if (document.fonts && typeof document.fonts.ready?.then === 'function') {
        document.fonts.ready.then(scheduleResizeReport).catch(() => {});
      }
      scheduleResizeReport();

      // Interaction logic
      {{#if interaction}}
      const messageId = '{{messageId}}';
      const interactionType = '{{interaction.type}}';
      const options = {{{optionsJson}}};

      function handleSubmit() {
        let answer;
        if (interactionType === 'text') {
          answer = document.getElementById('text-answer').value;
          if (!answer.trim()) {
            alert('Please enter an answer');
            return;
          }
        } else {
          const selected = Array.from(
            document.querySelectorAll('input[name="option"]:checked')
          ).map((input) => parseInt(input.value));

          if (selected.length === 0) {
            alert('Please select at least one option');
            return;
          }

          answer = interactionType === 'multiselect'
            ? selected.map((idx) => options[idx])
            : options[selected[0]];
        }

        window.parent.postMessage({
          type: 'tool',
          payload: {
            toolName: 'getUserAnswer',
            params: { messageId, answer },
          },
        }, '*');
      }

      function handleCancel() {
        window.parent.postMessage({
          type: 'tool',
          payload: {
            toolName: 'getUserAnswer',
            params: { messageId, answer: null, cancelled: true },
          },
        }, '*');
      }

      document.getElementById('submit-btn').addEventListener('click', handleSubmit);
      document.getElementById('cancel-btn').addEventListener('click', handleCancel);

      if (interactionType === 'text') {
        document.getElementById('text-answer').addEventListener('keypress', (e) => {
          if (e.key === 'Enter') handleSubmit();
        });
      }
      {{/if}}

      // Actions logic
      function showCheck(btn) {
        btn.querySelector('#icon-copy').style.display = 'none';
        btn.querySelector('#icon-check').style.display = 'block';
        setTimeout(function() { 
          btn.querySelector('#icon-copy').style.display = 'block';
          btn.querySelector('#icon-check').style.display = 'none';
        }, 2000);
      }

      function fallbackCopy(text, btn) {
        var textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.top = "0";
        textArea.style.left = "0";
        textArea.style.opacity = "0";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          if(document.execCommand('copy')) {
            showCheck(btn);
          }
        } catch (err) {}
        document.body.removeChild(textArea);
      }

      function encodeUtf8Base64(text) {
        var bytes = new TextEncoder().encode(text);
        var binary = '';
        for (var i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        return btoa(binary);
      }

      document.getElementById('copy-btn').addEventListener('click', function(e) {
        e.preventDefault();
        var btn = this;
        try {
          var raw = JSON.parse(document.getElementById('raw-data').textContent || '""');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(raw)
              .then(function() { showCheck(btn); })
              .catch(function() { fallbackCopy(raw, btn); });
          } else {
            fallbackCopy(raw, btn);
          }
        } catch(e) {}
      });

      (function setupExportMenu() {
        var exportBtn = document.getElementById('export-btn');
        var exportMenu = document.getElementById('export-menu');
        if (!exportBtn || !exportMenu) return;

        function closeMenu() {
          exportMenu.hidden = true;
          exportBtn.setAttribute('aria-expanded', 'false');
        }

        function openMenu() {
          exportMenu.hidden = false;
          exportBtn.setAttribute('aria-expanded', 'true');
        }

        exportBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (exportMenu.hidden) openMenu();
          else closeMenu();
        });

        document.addEventListener('click', function () {
          closeMenu();
        });

        exportMenu.addEventListener('click', function (e) {
          e.stopPropagation();
        });

        function readRawContent() {
          return JSON.parse(document.getElementById('raw-data').textContent || '""');
        }

        function readFileBaseName() {
          var titleEl = document.getElementById('content-title');
          var title = titleEl && !titleEl.hidden ? (titleEl.textContent || '').trim() : '';
          return title || 'export';
        }

        exportMenu.querySelectorAll('[data-export]').forEach(function (item) {
          item.addEventListener('click', function (e) {
            e.preventDefault();
            closeMenu();
            try {
              var raw = readRawContent();
              var kind = item.getAttribute('data-export');
              var fileBaseName = readFileBaseName();

              if (kind === 'html') {
                var encoded = encodeUtf8Base64(raw);
                window.parent.postMessage({
                  type: 'tool',
                  payload: {
                    toolName: 'tauri:downloadMediaFile',
                    params: {
                      dataBase64: encoded,
                      fileName: fileBaseName + '.html',
                      mimeType: 'text/html;charset=utf-8'
                    }
                  }
                }, '*');
                return;
              }

              window.parent.postMessage({
                type: 'tool',
                payload: {
                  toolName: kind === 'pdf'
                    ? 'tauri:exportMarkdownPdf'
                    : 'tauri:exportMarkdownFile',
                  params: {
                    content: raw,
                    fileBaseName: fileBaseName
                  }
                }
              }, '*');
            } catch (err) {
              console.error('Failed to export content', err);
            }
          });
        });
      })();
    </script>
  </body>
</html>
