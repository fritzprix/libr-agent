<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <style>
      body {
        margin: 0;
        padding: 16px;
        background: #f9fafb;
      }
      svg {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <svg viewBox='0 0 600 {{svgHeight}}' xmlns='http://www.w3.org/2000/svg'>
      <polyline
        points='{{points}}'
        fill='none'
        stroke='#3b82f6'
        stroke-width='2'
      />
      {{{labelsHtml}}}
    </svg>
    <script>
      // Auto-resize logic for MCP-UI client autoResizeIframe.
      const resizeTarget = document.querySelector('svg') || document.body;
      const bodyStyles = window.getComputedStyle(document.body);
      const bodyPaddingY =
        parseFloat(bodyStyles.paddingTop || '0') +
        parseFloat(bodyStyles.paddingBottom || '0');
      let lastReportedHeight = 0;
      let resizeFrame = null;

      function measureContentHeight() {
        const targetRect = resizeTarget.getBoundingClientRect();
        const measuredHeight =
          resizeTarget === document.body
            ? targetRect.height
            : targetRect.height + bodyPaddingY;

        return Math.max(1, Math.ceil(measuredHeight));
      }

      function reportSizeIfChanged() {
        resizeFrame = null;
        const height = measureContentHeight();
        if (height === lastReportedHeight) {
          return;
        }

        lastReportedHeight = height;
        window.parent.postMessage(
          { type: 'ui-size-change', payload: { height } },
          '*',
        );
      }

      function scheduleResizeReport() {
        if (resizeFrame !== null) {
          cancelAnimationFrame(resizeFrame);
        }
        resizeFrame = requestAnimationFrame(reportSizeIfChanged);
      }

      const ro = new ResizeObserver(scheduleResizeReport);
      ro.observe(resizeTarget);
      window.addEventListener('load', scheduleResizeReport);
      scheduleResizeReport();
    </script>
  </body>
</html>
