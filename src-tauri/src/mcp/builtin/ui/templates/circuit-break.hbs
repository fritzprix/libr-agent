<!doctype html>
<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 32px 16px;
        background: #fef3c7;
      }
      .circuit-container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border: 2px solid #f59e0b;
        border-radius: 8px;
        padding: 32px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .warning-icon {
        font-size: 48px;
        margin-bottom: 16px;
        text-align: center;
      }
      .title {
        font-size: 24px;
        font-weight: 700;
        color: #92400e;
        margin-bottom: 16px;
        text-align: center;
      }
      .message {
        font-size: 16px;
        color: #78350f;
        margin-bottom: 24px;
        line-height: 1.6;
      }
      .tool-info {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 12px 16px;
        margin-bottom: 24px;
        font-family:
          'Courier New',
          monospace;
        font-size: 14px;
        word-break: break-all;
      }
      .btn-resume {
        width: 100%;
        padding: 14px 24px;
        background: #f59e0b;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-resume:hover {
        background: #d97706;
      }
      .btn-resume:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.3);
      }
    </style>
  </head>
  <body>
    <div class='circuit-container' role='alert' aria-live='assertive'>
      <div class='warning-icon' aria-hidden='true'>⚠️</div>
      <div class='title'>Circuit Breaker Triggered</div>
      <div class='message'>
        The AI agent has repeatedly called the same tool with identical
        parameters. This usually indicates the agent is stuck in a loop.
      </div>
      <div class='tool-info'>
        <strong>Tool:</strong> {{toolName}}<br />
        <strong>Repetition Count:</strong> {{repetitionCount}}<br />
        {{#if args}}
        <strong>Arguments:</strong> {{args}}
        {{/if}}
      </div>
      <button class='btn-resume' onclick='handleResume()' autofocus>
        Resume Execution
      </button>
    </div>
    <script>
      const contextData = {{{contextJson}}};

      function handleResume() {
        window.parent.postMessage(
          {
            type: 'tool',
            payload: {
              toolName: 'resumeCircuitBreak',
              params: {
                toolName: contextData.toolName,
                repetitionCount: contextData.repetitionCount,
              },
            },
          },
          '*',
        );
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          handleResume();
        }
      });
    </script>
    <script>
      // Auto-resize logic for MCP-UI client autoResizeIframe
      const ro = new ResizeObserver(() => {
        const height = document.documentElement.scrollHeight || document.body.scrollHeight;
        window.parent.postMessage({ type: 'ui-size-change', payload: { height: height } }, '*');
      });
      ro.observe(document.body);
    </script>
  </body>
</html>
