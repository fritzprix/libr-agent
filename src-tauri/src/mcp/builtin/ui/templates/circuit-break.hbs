<!doctype html>
<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <style>
      /*
        Warning chrome stays amber; surfaces follow host theme tokens so dark
        mode does not get a full-bleed light panel.
      */
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 32px 16px;
        background: color-mix(in oklab, #f59e0b 20%, var(--background, #fffbeb));
        color: var(--foreground, #78350f);
      }
      .circuit-container {
        max-width: 600px;
        margin: 0 auto;
        background: var(--card, #ffffff);
        color: var(--card-foreground, #78350f);
        border: 2px solid #f59e0b;
        border-radius: 8px;
        padding: 32px;
        box-shadow: 0 4px 6px color-mix(in oklab, var(--foreground, #000000) 12%, transparent);
      }
      .warning-icon {
        font-size: 48px;
        margin-bottom: 16px;
        text-align: center;
      }
      .title {
        font-size: 24px;
        font-weight: 700;
        color: #d97706;
        margin-bottom: 16px;
        text-align: center;
      }
      .message {
        font-size: 16px;
        color: var(--muted-foreground, #78350f);
        margin-bottom: 24px;
        line-height: 1.6;
      }
      .tool-info {
        background: color-mix(in oklab, #f59e0b 16%, var(--muted, #fef3c7));
        border-left: 4px solid #f59e0b;
        padding: 12px 16px;
        margin-bottom: 24px;
        font-family:
          'Courier New',
          monospace;
        font-size: 14px;
        word-break: break-all;
        color: var(--foreground, #78350f);
      }
      .btn-resume {
        width: 100%;
        padding: 14px 24px;
        background: #f59e0b;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-resume:hover {
        background: #d97706;
      }
      .btn-resume:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.3);
      }
      .btn-resume:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }
      .resume-status {
        display: none;
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 6px;
        font-size: 14px;
        line-height: 1.45;
        border: 1px solid #fcd34d;
        background: color-mix(in oklab, #f59e0b 12%, var(--muted, #fffbeb));
        color: var(--foreground, #78350f);
      }
      .resume-status.is-visible {
        display: block;
      }
      .resume-status.is-success {
        border-color: #86efac;
        background: color-mix(in oklab, #16a34a 12%, var(--muted, #f0fdf4));
        color: var(--foreground, #14532d);
      }
      .resume-status.is-error {
        border-color: #fca5a5;
        background: color-mix(in oklab, #dc2626 10%, var(--muted, #fef2f2));
        color: var(--foreground, #7f1d1d);
      }
    </style>
  </head>
  <body>
    <div class='circuit-container' role='alert' aria-live='assertive'>
      <div class='warning-icon' aria-hidden='true'>⚠️</div>
      <div class='title'>Circuit Breaker Triggered</div>
      <div class='message'>
        The AI agent has repeatedly called the same tool with identical
        parameters. This usually indicates the agent is stuck in a loop.
      </div>
      <div class='tool-info'>
        <strong>Tool:</strong> {{toolName}}<br />
        <strong>Repetition Count:</strong> {{repetitionCount}}<br />
        {{#if args}}
        <strong>Arguments:</strong> {{args}}
        {{/if}}
      </div>
      <button id='resume-btn' class='btn-resume' type='button' autofocus>
        Resume Execution
      </button>
      <div
        id='resume-status'
        class='resume-status'
        role='status'
        aria-live='polite'
        aria-atomic='true'
      ></div>
    </div>
    <script>
      const contextData = {{{contextJson}}};
      const resumeBtn = document.getElementById('resume-btn');
      const resumeStatus = document.getElementById('resume-status');
      let resumeState = 'idle'; // idle | pending | success
      let pendingRequestId = null;

      function setResumeStatus(kind, text) {
        resumeStatus.className = 'resume-status is-visible' + (kind ? ' is-' + kind : '');
        resumeStatus.textContent = text;
        if (typeof scheduleResizeReport === 'function') {
          scheduleResizeReport();
        }
      }

      function handleResume() {
        if (resumeState !== 'idle') {
          return;
        }
        const requestId = 'ui-resume-' + Date.now().toString(36);
        pendingRequestId = requestId;
        resumeState = 'pending';
        resumeBtn.disabled = true;
        resumeBtn.textContent = 'Resuming…';
        setResumeStatus('', 'Resume requested — waiting for the agent…');

        window.parent.postMessage(
          {
            type: 'tool',
            messageId: requestId,
            payload: {
              toolName: 'resumeCircuitBreak',
              params: {
                toolName: contextData.toolName,
                repetitionCount: contextData.repetitionCount,
              },
            },
          },
          '*',
        );
      }

      function unlockResume(detail) {
        resumeState = 'idle';
        pendingRequestId = null;
        resumeBtn.disabled = false;
        resumeBtn.textContent = 'Resume Execution';
        setResumeStatus('error', detail || 'Could not resume. Please try again.');
      }

      window.addEventListener('message', function (event) {
        if (resumeState !== 'pending') return;
        const data = event.data;
        if (!data || typeof data !== 'object') return;
        if (
          data.messageId != null &&
          data.messageId !== '' &&
          data.messageId !== pendingRequestId
        ) {
          return;
        }
        if (data.type === 'ui-message-received') {
          setResumeStatus('', 'Host received resume — continuing…');
          return;
        }
        if (data.type !== 'ui-message-response') return;
        const payload = data.payload || {};
        if (payload.error) {
          unlockResume(
            typeof payload.error === 'string'
              ? payload.error
              : (payload.error && payload.error.message) || 'Resume failed.',
          );
          return;
        }
        const response = payload.response;
        const status =
          response && typeof response === 'object' ? response.status : undefined;
        if (status === 'ignored' || status === 'error' || status === 'tauri-error') {
          unlockResume(
            (response && response.message) ||
              'Session was not ready. Please try Resume again.',
          );
          return;
        }
        resumeState = 'success';
        pendingRequestId = null;
        resumeBtn.disabled = true;
        resumeBtn.textContent = 'Resumed';
        setResumeStatus(
          'success',
          'Circuit breaker cleared — agent is continuing.',
        );
      });

      resumeBtn.addEventListener('click', handleResume);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          handleResume();
        }
      });
    </script>
    <script>
      // Auto-resize logic for MCP-UI client autoResizeIframe.
      const resizeTarget =
        document.querySelector('.circuit-container') || document.body;
      const bodyStyles = window.getComputedStyle(document.body);
      const bodyPaddingY =
        parseFloat(bodyStyles.paddingTop || '0') +
        parseFloat(bodyStyles.paddingBottom || '0');
      let lastReportedHeight = 0;
      let resizeFrame = null;

      function measureContentHeight() {
        const targetRect = resizeTarget.getBoundingClientRect();
        const measuredHeight =
          resizeTarget === document.body
            ? targetRect.height
            : targetRect.height + bodyPaddingY;

        return Math.max(1, Math.ceil(measuredHeight));
      }

      function reportSizeIfChanged() {
        resizeFrame = null;
        const height = measureContentHeight();
        if (height === lastReportedHeight) {
          return;
        }

        lastReportedHeight = height;
        window.parent.postMessage(
          { type: 'ui-size-change', payload: { height } },
          '*',
        );
      }

      function scheduleResizeReport() {
        if (resizeFrame !== null) {
          cancelAnimationFrame(resizeFrame);
        }
        resizeFrame = requestAnimationFrame(reportSizeIfChanged);
      }

      const ro = new ResizeObserver(scheduleResizeReport);
      ro.observe(resizeTarget);
      window.addEventListener('load', scheduleResizeReport);
      scheduleResizeReport();
    </script>
  </body>
</html>
