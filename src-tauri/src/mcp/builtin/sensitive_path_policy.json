{
  "rules": [
    { "scope": "home", "match": "glob", "value": ".env*" },

    { "scope": "home", "match": "exact", "value": ".ssh" },
    { "scope": "home", "match": "glob", "value": ".ssh/**" },
    { "scope": "home", "match": "exact", "value": ".gnupg" },
    { "scope": "home", "match": "glob", "value": ".gnupg/**" },
    { "scope": "home", "match": "exact", "value": ".aws" },
    { "scope": "home", "match": "glob", "value": ".aws/**" },
    { "scope": "home", "match": "exact", "value": ".azure" },
    { "scope": "home", "match": "glob", "value": ".azure/**" },
    { "scope": "home", "match": "exact", "value": ".docker" },
    { "scope": "home", "match": "glob", "value": ".docker/**" },
    { "scope": "home", "match": "exact", "value": ".kube" },
    { "scope": "home", "match": "glob", "value": ".kube/**" },
    { "scope": "home", "match": "exact", "value": ".terraform.d" },
    { "scope": "home", "match": "glob", "value": ".terraform.d/**" },

    { "scope": "home", "match": "exact", "value": ".npmrc" },
    { "scope": "home", "match": "exact", "value": ".pypirc" },
    { "scope": "home", "match": "exact", "value": ".netrc" },
    { "scope": "home", "match": "exact", "value": ".git-credentials" },
    { "scope": "home", "match": "exact", "value": ".bashrc" },
    { "scope": "home", "match": "exact", "value": ".bash_profile" },
    { "scope": "home", "match": "exact", "value": ".profile" },
    { "scope": "home", "match": "exact", "value": ".zshrc" },
    { "scope": "home", "match": "exact", "value": ".zprofile" },
    { "scope": "home", "match": "exact", "value": ".zshenv" },
    { "scope": "home", "match": "exact", "value": ".terraform.d/credentials.tfrc.json" },

    { "scope": "home", "match": "exact", "value": ".config/gcloud" },
    { "scope": "home", "match": "glob", "value": ".config/gcloud/**" },
    { "scope": "home", "match": "exact", "value": ".config/gh" },
    { "scope": "home", "match": "glob", "value": ".config/gh/**" },
    { "scope": "home", "match": "exact", "value": ".config/fish" },
    { "scope": "home", "match": "glob", "value": ".config/fish/**" },
    { "scope": "home", "match": "exact", "value": ".config/fish/config.fish" },
    { "scope": "home", "match": "exact", "value": ".local/share/keyrings" },
    { "scope": "home", "match": "glob", "value": ".local/share/keyrings/**" },
    { "scope": "home", "match": "exact", "value": "Library/Keychains", "os": ["macos"] },
    { "scope": "home", "match": "glob", "value": "Library/Keychains/**", "os": ["macos"] },
    { "scope": "home", "match": "exact", "value": "Documents/PowerShell/Microsoft.PowerShell_profile.ps1" },
    { "scope": "home", "match": "exact", "value": "Documents/WindowsPowerShell/Microsoft.PowerShell_profile.ps1" },
    { "scope": "home", "match": "exact", "value": "AppData/Roaming/Microsoft/Crypto", "os": ["windows"] },
    { "scope": "home", "match": "glob", "value": "AppData/Roaming/Microsoft/Crypto/**", "os": ["windows"] },

    { "scope": "absolute", "match": "exact", "value": "/etc/ssh", "os": ["linux", "macos"] },
    { "scope": "absolute", "match": "glob", "value": "/etc/ssh/**", "os": ["linux", "macos"] },
    { "scope": "absolute", "match": "exact", "value": "/etc/ssl/private", "os": ["linux", "macos"] },
    { "scope": "absolute", "match": "glob", "value": "/etc/ssl/private/**", "os": ["linux", "macos"] },
    { "scope": "absolute", "match": "exact", "value": "/etc/shadow", "os": ["linux", "macos"] },
    { "scope": "absolute", "match": "exact", "value": "/etc/sudoers", "os": ["linux", "macos"] },

    { "scope": "absolute", "match": "glob", "value": "?:/ProgramData/ssh", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/ProgramData/ssh/**", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/ProgramData/Microsoft/Crypto/RSA/MachineKeys", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/ProgramData/Microsoft/Crypto/RSA/MachineKeys/**", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/Windows/System32/config", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/Windows/System32/config/**", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/Windows/System32/config/SAM", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/Windows/System32/config/SECURITY", "os": ["windows"] },
    { "scope": "absolute", "match": "glob", "value": "?:/Windows/System32/config/SYSTEM", "os": ["windows"] }
  ]
}
